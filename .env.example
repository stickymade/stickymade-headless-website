# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and should never be committed.

# Shopify store domain (no protocol, no trailing slash)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API version this app was built against
SHOPIFY_STOREFRONT_API_VERSION=2025-01

# Public Storefront API token (Settings > Apps > Develop apps > your app > Storefront API)
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# Private (delegate) Storefront API token — server-only, elevated access.
# Leave blank unless you specifically need it; never expose to the client.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
